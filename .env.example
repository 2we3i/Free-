NODE_ENV=production
LOG_LEVEL=info

# --- LLM (Gemini handles all text: idea + scene breakdown) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Video (Veo, via the Gemini API) ---
VEO_MODEL=veo-3.1-fast-generate-preview
VEO_POLL_INTERVAL_MS=10000
VEO_POLL_TIMEOUT_MS=600000

# --- Audio + stitching (Fal; Veo does not do either) ---
FAL_KEY=
FAL_AUDIO_MODEL=fal-ai/stable-audio
FAL_STITCH_MODEL=fal-ai/ffmpeg-api/compose
FAL_POLL_INTERVAL_MS=4000
FAL_POLL_TIMEOUT_MS=600000

# --- Postiz (self-hosted) ---
# OAuth for each network is configured in the Postiz UI.
# These IDs are Postiz integrations, not social network tokens.
POSTIZ_BASE_URL=http://your-postiz-instance:5000
POSTIZ_API_KEY=
# Comma-separated list of networks to actually publish to.
POSTIZ_ACTIVE_NETWORKS=tiktok,instagram,youtube
POSTIZ_INTEGRATION_TIKTOK=
POSTIZ_INTEGRATION_INSTAGRAM=
POSTIZ_INTEGRATION_YOUTUBE=
# Leave blank unless you add these networks to POSTIZ_ACTIVE_NETWORKS.
POSTIZ_INTEGRATION_LINKEDIN=
POSTIZ_INTEGRATION_FACEBOOK=
POSTIZ_INTEGRATION_X=
POSTIZ_INTEGRATION_THREADS=
POSTIZ_INTEGRATION_BLUESKY=
POSTIZ_INTEGRATION_PINTEREST=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_DEV_CHAT_ID=
APPROVAL_TIMEOUT_MS=2700000

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Runs

# --- Scheduler ---
CRON_SCHEDULE=0 9 * * *
TZ=UTC
