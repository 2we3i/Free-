NODE_ENV=production
LOG_LEVEL=info

# --- LLM (Gemini handles everything: trend search, idea, and the video prompt) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Manual video generation ---
# The pipeline sends one video-generation prompt to Telegram. The operator pastes it
# into a tool like the Gemini app (which generates an 8-15s clip with native audio in
# a single pass) and replies with the finished video. No Veo API, no separate audio
# step, and no stitching are needed.
# How long (ms) to wait for the operator to reply with the clip before giving up.
MANUAL_CLIP_TIMEOUT_MS=3600000

# --- Postiz (self-hosted) ---
# OAuth for each network is configured in the Postiz UI.
# These IDs are Postiz integrations, not social network tokens.
POSTIZ_BASE_URL=http://your-postiz-instance:5000
POSTIZ_API_KEY=
# Comma-separated list of networks to actually publish to.
POSTIZ_ACTIVE_NETWORKS=youtube
POSTIZ_INTEGRATION_YOUTUBE=
# Leave blank unless you add these networks to POSTIZ_ACTIVE_NETWORKS.
POSTIZ_INTEGRATION_TIKTOK=
POSTIZ_INTEGRATION_INSTAGRAM=
POSTIZ_INTEGRATION_LINKEDIN=
POSTIZ_INTEGRATION_FACEBOOK=
POSTIZ_INTEGRATION_X=
POSTIZ_INTEGRATION_THREADS=
POSTIZ_INTEGRATION_BLUESKY=
POSTIZ_INTEGRATION_PINTEREST=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_DEV_CHAT_ID=
APPROVAL_TIMEOUT_MS=2700000

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Runs

# --- Scheduler ---
CRON_SCHEDULE=0 9 * * *
TZ=UTC
