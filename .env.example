NODE_ENV=production
LOG_LEVEL=info

# --- LLM ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_DETAIL_MODEL=gpt-5
DETAIL_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Media ---
WAVESPEED_API_KEY=
WAVESPEED_BASE_URL=https://api.wavespeed.ai
WAVESPEED_MODEL=wavespeed-ai/wan-2.1/t2v
WAVESPEED_POLL_INTERVAL_MS=5000
WAVESPEED_POLL_TIMEOUT_MS=600000

FAL_KEY=
FAL_AUDIO_MODEL=fal-ai/stable-audio
FAL_STITCH_MODEL=fal-ai/ffmpeg-api/compose
FAL_POLL_INTERVAL_MS=4000
FAL_POLL_TIMEOUT_MS=600000

# --- Postiz (self-hosted) ---
# OAuth for the 9 networks is configured in the Postiz UI.
# These IDs are Postiz integrations, not social network tokens.
POSTIZ_BASE_URL=http://your-postiz-instance:5000
POSTIZ_API_KEY=
POSTIZ_INTEGRATION_TIKTOK=
POSTIZ_INTEGRATION_LINKEDIN=
POSTIZ_INTEGRATION_FACEBOOK=
POSTIZ_INTEGRATION_INSTAGRAM=
POSTIZ_INTEGRATION_X=
POSTIZ_INTEGRATION_YOUTUBE=
POSTIZ_INTEGRATION_THREADS=
POSTIZ_INTEGRATION_BLUESKY=
POSTIZ_INTEGRATION_PINTEREST=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_DEV_CHAT_ID=
APPROVAL_TIMEOUT_MS=2700000

# --- Google Sheets ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_TAB=Runs

# --- Scheduler ---
CRON_SCHEDULE=0 9 * * *
TZ=UTC
